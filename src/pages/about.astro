---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="About — JusDots" description="JusDots makes quiet, offline-first software.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24">
    <h1 class="display text-5xl md:text-7xl">Quiet tools,<br />one job well.</h1>
    <p class="mt-8 text-lg leading-relaxed">Room to think, connect and get inspired — with instant access to your files and nothing phoning home. JusDots builds close to the platform and far from accounts, ads, and dashboards.</p>
    <p class="mt-4 leading-relaxed text-neutral-500">Every product ships offline-first, with a public changelog and a download that does not ask for your email.</p>
  </section>
</SiteLayout>
