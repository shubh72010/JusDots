---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SpecGrid from '../../components/SpecGrid.astro';
import PillDownload from '../../components/PillDownload.astro';
import { getCollection, render } from 'astro:content';
import { stars } from '../../data/meta';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;
const base = import.meta.env.BASE_URL;

const all = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex((p) => p.id === product.id) + 1) % all.length] ?? product;
---

<SiteLayout title={`${d.title} — JusDots`} description={d.description}>
  <article class="px-6 pt-32 pb-32">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-start gap-6">
        {d.icon && (
          <img
            src={`${base}${d.icon.slice(1)}`}
            alt=""
            class="chunky mt-3 size-20 shrink-0 border border-black/10"
            style={`view-transition-name: product-${product.id}`}
          />
        )}
        <div class="min-w-0 flex-1">
          <p class="spec-label mb-5">{d.kind} · {d.status} · ★ {stars[product.id] ?? '–'}</p>
          <h1 class="display text-4xl md:text-7xl">{d.title}</h1>
        </div>
      </div>
      <p class="serif-accent mt-8 max-w-2xl text-2xl text-neutral-600">{d.tagline}</p>
      <div class="sticky top-20 z-30 -mx-6 mt-10 hidden items-center justify-between border-y hairline bg-[#f5f4f2]/95 px-6 py-2 backdrop-blur md:flex">
        <span class="spec-label">{d.title}</span>
        <span class="spec-label">v{d.version} · {d.status}</span>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1.1fr]">
        <div>
          <h2 class="spec-label mb-3">Specs</h2>
          <SpecGrid version={d.version} platforms={d.platforms} size={d.size} license={d.license} updated={d.updated} />
          <div class="rich mt-10 max-w-none"><Content /></div>
        </div>
        <div>
          {d.screenshots.length > 0 ? (
            <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 md:grid md:grid-cols-2 md:overflow-visible">
              {d.screenshots.slice(0, 4).map((s) => {
                const wide = s.includes('banner') || s.includes('calc');
                return <img src={`${base}${s.slice(1)}`} alt={`${d.title} screenshot`} loading="lazy" class:list={['reveal object-cover', wide ? 'chunky border hairline w-full shrink-0 snap-center md:w-full' : 'phone w-60 shrink-0 snap-center md:w-full']} />;
              })}
            </div>
          ) : (
            <div class="chunky border hairline bg-[#141414] p-10 text-[#f5f4f2]">
              <p class="spec-label !text-neutral-400">{d.kind}</p>
              <p class="display mt-4 text-5xl">{d.title}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </article>
  <nav class="mx-auto max-w-6xl px-6 pb-28" aria-label="Next project">
    <a href={`${base}products/${next.id}/`} class="row-glow group flex items-center justify-between gap-6 border-y hairline py-8">
      <span class="spec-label">Next project</span>
      <span class="flex items-center gap-4">
        <span class="display text-3xl md:text-5xl">{next.data.title}</span>
        <span class="row-arrow text-2xl text-neutral-400" aria-hidden="true">→</span>
      </span>
    </a>
  </nav>
  <PillDownload version={d.version} platforms={d.platforms} repo={d.repo} />
</SiteLayout>
