---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SpecGrid from '../../components/SpecGrid.astro';
import PillDownload from '../../components/PillDownload.astro';
import { getCollection, render } from 'astro:content';
import { stars } from '../../data/meta';
import { getReleases } from '../../data/releases';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;
const base = import.meta.env.BASE_URL;
const latest = (await getReleases(d.repo))[0];
---

<SiteLayout title={`${d.title} — JusDots`} description={d.description}>
  <article class="px-6 pt-32 pb-32">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:gap-6">
        {d.icon && (
          <img
            src={`${base}${d.icon.slice(1)}`}
            alt=""
            class="chunky size-16 shrink-0 border border-black/10 md:mt-3 md:size-20"
            style={`view-transition-name: product-${product.id}`}
          />
        )}
        <div class="min-w-0 flex-1">
          <p class="spec-label mb-5">{d.kind} · {d.status} · ★ {stars[product.id] ?? '–'}</p>
          <h1 class="display text-4xl md:text-7xl">{d.title}</h1>
        </div>
      </div>
      <p class="serif-accent mt-8 max-w-2xl text-2xl text-neutral-600">{d.tagline}</p>
      <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-[1fr_1.1fr]">
        <div class="min-w-0">
          <h2 class="spec-label mb-3">Specs</h2>
          <SpecGrid
            version={d.version}
            platforms={d.platforms}
            size={d.size}
            license={d.license}
            updated={d.updated}
            changelogHref={`${base}products/${product.id}/changelog/`}
          />
          <a href={`${base}products/${product.id}/changelog/`} class="spec-label mt-4 inline-block hover:text-black">Changelog →</a>
          {d.repo && (
            <a
              href={d.repo}
              class="row-glow chunky mt-3 flex items-center gap-3 border hairline bg-white/60 px-4 py-3.5"
            >
              <svg viewBox="0 0 16 16" class="size-5" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.06.55-.17.55-.38 0-.19-.01-.82-.01-1.4-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              <span class="text-sm font-semibold tracking-tight">View repository</span>
              <span class="spec-label ml-auto">{d.repo.replace('https://github.com/', '')} →</span>
            </a>
          )}
          <div class="rich mt-10 max-w-none"><Content /></div>
        </div>
        <div class="min-w-0">
          {d.screenshots.length > 0 ? (
            <div class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2 md:grid md:grid-cols-2 md:overflow-visible">
              {d.screenshots.slice(0, 4).map((s) => {
                const wide = s.includes('banner') || s.includes('calc');
                return <img src={`${base}${s.slice(1)}`} alt={`${d.title} screenshot`} loading="lazy" class:list={['reveal object-cover', wide ? 'chunky border hairline w-full shrink-0 snap-center md:w-full' : 'phone w-60 shrink-0 snap-center md:w-full']} />;
              })}
            </div>
          ) : (
            <div class="chunky border hairline bg-[#141414] p-10 text-[#f5f4f2]">
              <p class="spec-label !text-neutral-400">{d.kind}</p>
              <p class="display mt-4 text-5xl">{d.title}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </article>
  <PillDownload
    version={d.version}
    platforms={d.platforms}
    repo={d.repo}
    latest={latest && { tag: latest.tag, apkUrl: latest.apkUrl }}
    changelogHref={`${base}products/${product.id}/changelog/`}
  />
</SiteLayout>
