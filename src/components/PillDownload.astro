---
import type { Release } from '../data/releases';

interface Props {
  version: string;
  platforms: string[];
  repo?: string;
  /** newest GitHub release: shown version and direct APK download */
  latest?: Pick<Release, 'tag' | 'apkUrl'>;
  /** in-site changelog for the version click */
  changelogHref?: string;
}

const { version, platforms, repo, latest, changelogHref } = Astro.props;
const primary = platforms[0] ?? 'Android';
const multi = platforms.length > 1;
const shown = latest?.tag ?? `v${version}`;
// direct APK asset (same URL GitHub's release page uses, so downloads still count); falls back to the releases page
const download = latest?.apkUrl ?? repo;
---

<div class="fixed bottom-4 left-1/2 z-10 w-max max-w-[calc(100vw-2rem)] -translate-x-1/2">
  <div class="flex items-center gap-2.5 rounded-full border border-white/10 bg-[#141414] py-2 pl-3.5 pr-1.5 text-white shadow-xl">
    <span class="flex shrink-0 gap-1.5" aria-hidden="true">
      {platforms.map((p) => (
        <span class="inline-block size-2 rounded-full bg-[#f96749]" title={p}></span>
      ))}
    </span>
    <a
      href={changelogHref}
      class="whitespace-nowrap font-mono text-[11px]"
      title="Full changelog"
    >{shown} · {multi ? `${platforms.length} platforms` : primary}</a>
    {download ? (
      <a href={download} class="rounded-full bg-[#f96749] px-4 py-1.5 text-sm font-semibold text-white">Download</a>
    ) : (
      <span class="rounded-full bg-white/15 px-4 py-1.5 text-sm">Coming soon</span>
    )}
  </div>
</div>
