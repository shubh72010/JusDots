---
const base = import.meta.env.BASE_URL;
// icon shown under 620px, text shown at and above — labels stay in aria/title for each
const links = [
  {
    href: '/products/',
    label: 'Products',
    icon: '<svg viewBox="0 0 16 16" class="size-4 min-[620px]:hidden" fill="none" stroke="currentColor" stroke-width="1.8" shape-rendering="geometricPrecision"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.5"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.5"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1.5"/><rect x="9" y="9" width="5.5" height="5.5" rx="2.75"/></svg>',
  },
  {
    href: '/changelog/',
    label: 'Changelog',
    icon: '<svg viewBox="0 0 16 16" class="size-4 min-[620px]:hidden" fill="none" stroke="currentColor" stroke-width="1.8" shape-rendering="geometricPrecision"><circle cx="8" cy="8" r="6.25"/><path d="M8 4.5V8l2.5 1.5"/></svg>',
  },
  {
    href: '/about/',
    label: 'About',
    icon: '<svg viewBox="0 0 16 16" class="size-4 min-[620px]:hidden" fill="none" stroke="currentColor" stroke-width="1.8" shape-rendering="geometricPrecision"><circle cx="8" cy="5.25" r="2.75"/><path d="M2.5 13.75c.9-2.6 3-4 5.5-4s4.6 1.4 5.5 4"/></svg>',
  },
  {
    href: '/donate/',
    label: 'Donate',
    icon: '<svg viewBox="0 0 16 16" class="size-4 min-[620px]:hidden" fill="none" stroke="currentColor" stroke-width="1.8" shape-rendering="geometricPrecision"><path d="M8 13.5S2.5 10.25 2.5 6.4C2.5 4.3 4.1 2.75 6 2.75c1 0 1.7.45 2 1 .3-.55 1-1 2-1 1.9 0 3.5 1.55 3.5 3.65C13.5 10.25 8 13.5 8 13.5Z"/></svg>',
  },
];
---

<div class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav class="flex items-center gap-0.5 rounded-full border border-black/10 bg-[#f5f4f2]/85 py-1.5 pl-5 pr-1.5 backdrop-blur-md" aria-label="Primary">
    <a href={`${base}`} class="mr-4 flex items-center gap-2 text-sm font-bold tracking-tight">
      <img src={`${base}icons/jusdots-64.png`} alt="" class="size-6 rounded-full" />
      <span class="min-[620px]:hidden text-xs">JUSDOTS</span>
      <span class="hidden min-[620px]:inline">JUSDOTS</span>
    </a>
    {links.map((l) => (
      <a
        href={`${base}${l.href.slice(1)}`}
        aria-label={l.label}
        title={l.label}
        class:list={['grid place-items-center rounded-full px-2.5 py-1.5 text-sm text-neutral-700 transition-colors hover:bg-black/5 hover:text-black min-[620px]:px-3.5']}
      >
        <span class="contents" set:html={l.icon} />
        <span class="hidden min-[620px]:inline">{l.label}</span>
      </a>
    ))}
    <a href="https://github.com/shubh72010" class="ml-2 rounded-full bg-[#141414] px-4 py-1.5 text-sm font-semibold text-white">GitHub</a>
  </nav>
</div>
